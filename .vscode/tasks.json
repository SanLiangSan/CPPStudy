{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build cpp",
        "type": "shell",
        "command": "g++",
        "args": [
          "-std=c++17",          // 使用 C++17 标准
          "-Wall",               // 开启警告
          "src/main.cpp",        // 源文件路径
          "-o",                  // 输出文件
          "main"                 // 生成的可执行文件名
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": ["$gcc"],
        "detail": "编译 C++ 源代码"
      }
    ]
  }
  